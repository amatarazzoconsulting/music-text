track keys_intro instrument rhodes pattern intro_voicing volume -9db pan -14
track keys_a instrument rhodes pattern comp_a volume -8db pan -14
track keys_b instrument rhodes pattern comp_b volume -8db pan -14
track keys_outro instrument rhodes pattern ending_keys volume -9db pan -14
track bass_outro instrument finger_bass pattern ending_bass volume -7db
track bass_a instrument finger_bass pattern walking_a volume -7db
track bass_b instrument finger_bass pattern walking_b volume -7db
track drums instrument jazz_kit pattern ride_groove volume -8db
track sax_a instrument tenor pattern hook_a volume -7db pan 10
track sax_b instrument tenor pattern hook_b volume -7db pan 10
track sax_final instrument tenor pattern hook_final volume -6db pan 8
track vibes instrument mallets pattern mallet_answer volume -17db pan -24
track trumpet instrument muted_brass pattern trumpet_answer volume -15db pan 24
track pad_a instrument velvet_pad pattern pad_a volume -30db pan 12
track pad_b instrument velvet_pad pattern pad_b volume -30db pan 12
track pad_outro instrument velvet_pad pattern ending_pad volume -30db pan 12

section intro
    length 2 bars
    only keys_intro
section head_a
    length 8 bars
    only keys_a
    add bass_a
    add drums
    add sax_a
    add pad_a
section head_a2
    length 8 bars
    only keys_a
    add bass_a
    add drums
    add sax_a
    add vibes
    add pad_a
section bridge
    length 8 bars
    only keys_b
    add bass_b
    add drums
    add sax_b
    add pad_b
section head_final
    length 8 bars
    only keys_a
    add bass_a
    add drums
    add sax_final
    add vibes
    add trumpet
    add pad_a
section outro
    length 2 bars
    only keys_outro
    add bass_outro
    add pad_outro
section tail
    length 1 bar
    remove all

over 2 bars in intro
    keys_intro.volume from -17db to -9db
over 4 bars in head_a2
    sax_a.volume from -9db to -7db
over 4 bars in head_final
    sax_final.volume from -8db to -6db
    pad_a.filter.cutoff from 900hz to 1700hz
over 2 bars in outro
    keys_outro.volume from -9db to -36db
    pad_outro.volume from -30db to -46db
humanize all tracks
    timing ±4ms
    velocity ±4%
master
    peak -2db
