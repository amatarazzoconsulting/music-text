track piano_intro instrument piano pattern intro_voicing volume -7db pan -12
track piano_comp instrument piano pattern comp volume -5db pan -12
track piano_coda instrument piano pattern coda_voicing volume -7db pan -12
track bass instrument upright_bass pattern walking_bass volume -6db
track muted_theme instrument muted_trumpet pattern trumpet_theme volume -6db pan 12
track clarinet_fill instrument clarinet pattern clarinet_response volume -10db pan -16
track low_brass instrument trombone pattern trombone_answers volume -9db pan -6
track brush_kit instrument brushes pattern brush_groove volume -8db
track trumpet_coda instrument muted_trumpet pattern coda_line volume -8db pan 12
track trombone_coda instrument trombone pattern coda_line volume -11db pan -8

section introduction
    length 4 bars
    only piano_intro
section statement_one
    length 12 bars
    only piano_comp
    add bass
    add brush_kit
    add muted_theme
    add low_brass
section statement_two
    length 12 bars
    only piano_comp
    add bass
    add brush_kit
    add muted_theme
    add clarinet_fill
    add low_brass
section coda
    length 4 bars
    only piano_coda
    add trumpet_coda
    add trombone_coda
over 4 bars in coda
    piano_coda.volume from -7db to -24db
    trumpet_coda.volume from -8db to -28db
    trombone_coda.volume from -11db to -30db
section tail
    length 1 bar
    remove all

humanize all tracks
    timing ±4ms
    velocity ±3%
master
    peak -2db
