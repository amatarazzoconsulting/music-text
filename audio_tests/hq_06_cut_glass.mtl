track keys instrument velvet_keys pattern voicings volume -15db pan -18
track pad instrument luminous_pad pattern atmosphere volume -23db pan 12
track bass instrument neon_bass pattern lowline volume -10db
track drums instrument drums pattern groove volume -8db
    reverb room mix 0.025
track theme_a instrument prism_pluck pattern theme_a volume -9db pan 9
track theme_b instrument prism_pluck pattern theme_b volume -9db pan -7
    delay time 0.335821s feedback 0.2 mix 0.08

section intro
    length 2 bars
    remove all
    add keys
    add pad
section verse
    length 8 bars
    add bass
    add drums
    add theme_a
section bridge
    length 2 bars
    remove drums
    remove theme_a
section lift
    length 8 bars
    add drums
    add theme_b
section outro
    length 2 bars
    remove bass
    remove drums
    remove theme_b
section tail
    length 1 bar
    remove all

over 2 bars in intro
    keys.volume from -24db to -15db
    pad.filter.cutoff from 650hz to 1900hz
over 4 bars in verse
    bass.filter.cutoff from 450hz to 1800hz
over 2 bars in bridge
    pad.filter.cutoff from 1900hz to 750hz
over 4 bars in lift
    theme_b.filter.cutoff from 1800hz to 7500hz
over 2 bars in outro
    keys.volume from -15db to -42db
    pad.volume from -23db to -48db
humanize all tracks
    timing ±2ms
    velocity ±3%
master
    peak -3db
