section intro
    length 2 bars
    remove all
    add keys
    add pad
section verse
    length 12 bars
    add bass
    add drums
    add theme_a
section bridge
    length 2 bars
    remove drums
    remove theme_a
section lift
    length 12 bars
    add drums
    add theme_b
section outro
    length 2 bars
    remove bass
    remove drums
    remove theme_b
section tail
    length 1 bar
    remove all

over 2 bars in intro
    keys.volume from -24db to -15db
    pad.filter.cutoff from 650hz to 1900hz
over 4 bars in verse
    bass.filter.cutoff from 450hz to 1100hz
over 2 bars in bridge
    pad.filter.cutoff from 1900hz to 750hz
over 4 bars in lift
    theme_b.filter.cutoff from 1800hz to 7500hz
over 2 bars in outro
    keys.volume from -15db to -42db
    pad.volume from -23db to -48db
humanize all tracks
    timing ±5ms
    velocity ±5%
master
    peak -3db
