song "Signal Garden"
bpm 108
time_signature 4/4
sample_rate 44100
bit_depth 24
seed 24
import "../mtl/presets/hybrid.mtl"

pattern harmony
    length 4 bars
    chord d3 f3 a3 on 1 hold 4 beats vel 0.72
    chord bb2 d3 f3 on 5 hold 4 beats vel 0.66
    chord c3 e3 g3 on 9 hold 4 beats vel 0.7
    chord a2 c3 e3 on 13 hold 4 beats vel 0.64

pattern pulse
    length 4 bars
    chord d4 f4 a4 on 1 hold 4 beats vel 0.68
    chord bb3 d4 f4 on 5 hold 4 beats vel 0.64
    chord c4 e4 g4 on 9 hold 4 beats vel 0.68
    chord a3 c4 e4 on 13 hold 4 beats vel 0.62

pattern bassline
    length 4 bars
    d2 on 1,3,4,6,7,9,11,12,14,15 hold 0.42 beats vel 0.8
    bb1 on 5,7,8,10,11,13,15,16 hold 0.42 beats vel 0.78

pattern melody
    length 4 bars
    a4 on 1 hold 0.75 beats vel 0.72
    d5 on 2.5 hold 0.5 beats vel 0.75
    f5 on 3 hold 1.25 beats vel 0.78
    e5 on 5 hold 0.75 beats vel 0.68
    d5 on 6.5 hold 0.5 beats vel 0.72
    bb4 on 7 hold 1.5 beats vel 0.76
    g4 on 9 hold 0.75 beats vel 0.7
    c5 on 10.5 hold 0.5 beats vel 0.75
    e5 on 11 hold 1.25 beats vel 0.8
    c5 on 13 hold 0.75 beats vel 0.72
    a4 on 14.5 hold 0.5 beats vel 0.66
    d5 on 15 hold 1.5 beats vel 0.77

pattern drums
    length 4 bars
    kick on 1,5,9,13 vel 0.8
    snare on 3,7,11,15 vel 0.65
    hihat every 1/8 vel 0.32

track atmosphere instrument layered_sky pattern harmony volume -9db
track keys instrument metallic_keys pattern pulse volume -14db pan -8
track sequence instrument contour_bass pattern pulse volume -10db
    arpeggiator rate 1/8 mode up_down octaves 2 gate 0.72 pattern 1,3,2,4,0,3,2,4
track low instrument contour_bass pattern bassline volume -8db
track lead instrument vector_lead pattern melody volume -11db pan 12
track kit instrument drums pattern drums volume -9db

section opening
    length 4 bars
    atmosphere only
section movement
    length 4 bars
    add sequence
    add low
    add kit
    add keys
    add lead
section afterglow
    length 2 bars
    remove sequence
    remove low
    remove kit
    remove lead
humanize all tracks
    timing ±4ms
    velocity ±4%
master
    peak -1db
