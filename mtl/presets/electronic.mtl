// CodeRabbit generated synthesis presets. Original parameters; no sampled assets.
instrument velvet_pad
    oscillator saw unison 5 detune 0.007
    filter lowpass cutoff 2600hz resonance 0.65
    envelope attack 300ms decay 700ms sustain 0.65 release 1100ms
    reverb hall mix 0.20
instrument focused_sub
    oscillator sine
    envelope attack 6ms decay 120ms sustain 0.8 release 80ms
    filter lowpass cutoff 350hz
instrument cutting_lead
    oscillator saw unison 5 detune 0.012
    envelope attack 5ms decay 200ms sustain 0.65 release 180ms
    filter lowpass cutoff 6500hz resonance 0.8
    delay time 0.25s feedback 0.3 mix 0.16
instrument moving_bass
    oscillator square unison 3 detune 0.008
    filter lowpass cutoff 1200hz resonance 0.9
    lfo rate 1/8 target filter.cutoff depth 900hz
    distortion medium

instrument glass_sub
    type synth
    oscillator sine unison 1
    oscillator2 triangle level 0.18 transpose -12
    filter lowpass cutoff 240hz resonance 0.55
    envelope attack 8ms decay 140ms sustain 0.82 release 90ms
    compressor threshold -12db ratio 2.2 attack 12ms release 110ms

instrument ember_bass
    type synth
    oscillator saw unison 2 detune 0.004
    oscillator2 sine level 0.52 transpose -12
    filter lowpass cutoff 680hz resonance 0.92
    envelope attack 3ms decay 210ms sustain 0.68 release 120ms
    distortion light

