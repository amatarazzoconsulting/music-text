// Original layered and dual-oscillator presets for MTL's built-in engines.
import bank "electronic"
import bank "acoustic"
import bank "organs"

instrument glass_string
    type synth
    oscillator triangle unison 3 detune 0.004
    oscillator2 sine level 0.28 transpose 12
    filter lowpass cutoff 5200hz resonance 0.7
    envelope attack 35ms decay 900ms sustain 0.62 release 900ms
    chorus rate 0.22hz depth 0.0035 mix 0.32
    reverb hall mix 0.16

instrument layered_sky
    type layered
    layers velvet_pad glass_string
    layer_balance 0.78 0.48
    filter lowpass cutoff 4800hz resonance 0.65
    reverb ambient mix 0.24
    granular size 120ms density 10hz spray 35ms pitch 0 mix 0.08

instrument vector_lead
    oscillator saw unison 4 detune 0.009
    oscillator2 square level 0.18 transpose 12 detune 0.003
    filter lowpass cutoff 6100hz resonance 0.82
    envelope attack 8ms decay 260ms sustain 0.58 release 240ms
    lfo rate 1/8 target filter.cutoff depth 520hz
    overdrive drive 1.8 tone 6200hz mix 0.24
    delay time 0.375s feedback 0.28 mix 0.16

instrument contour_bass
    type synth
    oscillator square unison 2 detune 0.004
    oscillator2 sine level 0.42 transpose -12
    filter lowpass cutoff 980hz resonance 0.88
    envelope attack 4ms decay 180ms sustain 0.7 release 100ms
    compressor threshold -12db ratio 2.5 attack 8ms release 90ms

instrument grain_halo
    oscillator sine unison 2 detune 0.006
    oscillator2 triangle level 0.35 transpose 7
    filter lowpass cutoff 7200hz resonance 0.55
    envelope attack 180ms decay 700ms sustain 0.72 release 1300ms
    granular size 95ms density 15hz spray 90ms pitch 7 mix 0.22
    reverb shimmer mix 0.22
    delay time 0.5s feedback 0.35 mix 0.12

instrument metallic_keys
    type fm
    envelope attack 3ms decay 900ms sustain 0.18 release 600ms
    filter lowpass cutoff 11000hz resonance 0.5
    chorus rate 0.35hz depth 0.0025 mix 0.18
    reverb plate mix 0.18

instrument coral_mallet
    layers studio_vibes cobalt_fm
    layer_balance 0.82 0.42
    envelope attack 12ms decay 800ms sustain 0.52 release 900ms
    reverb hall mix 0.18

instrument felt_circuit
    layers felt_keys velvet_pad
    layer_balance 0.74 0.3
    filter lowpass cutoff 6200hz resonance 0.58
    chorus rate 0.24hz depth 0.002 mix 0.18

instrument brass_mist
    layers dusky_trumpet glass_string
    layer_balance 0.7 0.36
    filter lowpass cutoff 7600hz resonance 0.55
    reverb room mix 0.14

instrument organ_aurora
    layers jazz_drawbar vapor_sweep
    layer_balance 0.72 0.3
    rotary 1.4
    reverb hall mix 0.2

instrument hollow_choir
    layers solo_violin vapor_sweep
    layer_balance 0.7 0.32
    envelope attack 190ms decay 750ms sustain 0.68 release 1200ms
    granular size 110ms density 12hz spray 45ms pitch 0 mix 0.08

instrument copper_tine
    layers acoustic_piano graphite_keys
    layer_balance 0.84 0.34
    filter lowpass cutoff 8400hz resonance 0.5
    chorus rate 0.3hz depth 0.0015 mix 0.12

instrument moon_cello
    layers amber_cello grain_halo
    layer_balance 0.78 0.24
    filter lowpass cutoff 4800hz resonance 0.62
    reverb hall mix 0.21

instrument wire_pluck
    layers nylon_pluck ion_drive
    layer_balance 0.8 0.2
    filter lowpass cutoff 6400hz resonance 0.5
    delay time 0.375s feedback 0.22 mix 0.12

instrument opal_drawbar
    layers cathedral_organ orbit_bell
    layer_balance 0.7 0.28
    rotary 0.35
    reverb cathedral mix 0.2

instrument reed_shimmer
    layers reed_viola cobalt_fm
    layer_balance 0.76 0.28
    filter lowpass cutoff 6600hz resonance 0.62
    chorus rate 0.18hz depth 0.003 mix 0.22

instrument low_tide
    layers focused_sub amber_cello
    layer_balance 0.86 0.24
    filter lowpass cutoff 950hz resonance 0.7
    compressor threshold -12db ratio 2.4 attack 10ms release 100ms

instrument cloud_brass
    layers bright_fanfare grain_halo
    layer_balance 0.78 0.25
    filter lowpass cutoff 8800hz resonance 0.52
    reverb hall mix 0.22

instrument violet_halo
    oscillator triangle unison 4 detune 0.008
    oscillator2 sine level 0.28 transpose 12 detune 0.002
    filter lowpass cutoff 4300hz resonance 0.55
    envelope attack 240ms decay 650ms sustain 0.72 release 1300ms
    chorus rate 0.16hz depth 0.004 mix 0.3
    granular size 120ms density 10hz spray 50ms pitch 5 mix 0.12

instrument tungsten_voice
    oscillator saw unison 3 detune 0.007
    oscillator2 square level 0.16 transpose -12
    filter lowpass cutoff 2700hz resonance 0.8
    envelope attack 24ms decay 320ms sustain 0.62 release 450ms
    overdrive drive 1.4 tone 3200hz mix 0.16
    delay time 0.25s feedback 0.18 mix 0.1

instrument prism_organ
    type organ
    drawbars 8 4 7 3 2 0 0 0 0
    rotary 1.2
    percussion 0.12
    vibrato rate 5.4hz depth 0.0015
    chorus rate 0.28hz depth 0.003 mix 0.22
    reverb plate mix 0.16

instrument granular_lute
    type pluck
    envelope attack 5ms decay 700ms sustain 0.22 release 500ms
    filter lowpass cutoff 5200hz resonance 0.62
    granular size 75ms density 16hz spray 80ms pitch 7 mix 0.16
    delay time 0.5s feedback 0.24 mix 0.14
